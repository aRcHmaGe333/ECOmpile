{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_artifact_manifest",
  "type": "object",
  "required": ["generated_utc", "public_safe", "artifacts"],
  "properties": {
    "generated_utc": { "type": "string", "minLength": 1 },
    "public_safe": { "type": "boolean" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sensitivity"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sensitivity": { "type": "string", "enum": ["public", "internal"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
